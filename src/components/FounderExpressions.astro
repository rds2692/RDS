---
const expressions = [
  {
    src: '/images/armando/expresion-01.webp',
    alt: 'Armando Rangel con una expresión tranquila y sonriente',
    label: 'Observando',
    caption: 'Primero entendemos el proyecto. Después movemos una sola pieza.',
  },
  {
    src: '/images/armando/expresion-02.webp',
    alt: 'Armando Rangel riendo con entusiasmo',
    label: 'Haciendo clic',
    caption: 'Ese momento en que la estrategia, el contenido y el diseño empiezan a encajar.',
  },
  {
    src: '/images/armando/expresion-03.webp',
    alt: 'Armando Rangel con una expresión de sorpresa',
    label: 'Descubriendo',
    caption: 'Siempre hay un detalle que merece una segunda mirada antes de publicar.',
  },
  {
    src: '/images/armando/expresion-04.webp',
    alt: 'Armando Rangel mirando de forma atenta y neutral',
    label: 'Escuchando',
    caption: 'Una buena primera conversación parte por escuchar, ordenar y no adelantarse.',
  },
  {
    src: '/images/armando/expresion-05.webp',
    alt: 'Armando Rangel con una expresión de duda',
    label: 'Preguntando',
    caption: 'La pregunta incómoda también ayuda a tomar una mejor decisión.',
  },
  {
    src: '/images/armando/expresion-06.webp',
    alt: 'Armando Rangel con una expresión decidida y concentrada',
    label: 'Definiendo',
    caption: 'Cuidar el detalle, explicar el criterio y cumplir lo conversado.',
  },
  {
    src: '/images/armando/expresion-07.webp',
    alt: 'Armando Rangel sonriendo y mirando hacia un costado',
    label: 'Conversemos',
    caption: 'Hola, soy Armando. Me gustaría conocer qué necesita crecer en tu negocio.',
  },
] as const;

const initial = expressions[0];
---

<figure class="founder-gallery" data-founder-gallery aria-label="Galería de expresiones de Armando Rangel">
  <div class="founder-gallery-top">
    <span>RDS / FUNDADOR</span>
    <span data-founder-count>01 — 07</span>
  </div>

  <div class="founder-stage">
    <span class="founder-orbit" aria-hidden="true"></span>
    <span class="founder-spark" aria-hidden="true">✳</span>
    <div class="founder-window">
      <span class="founder-window-label">ARMANDO RANGEL</span>
      <img
        src={initial.src}
        alt={initial.alt}
        width="370"
        height="366"
        decoding="async"
        data-founder-image
      />
    </div>
    <span class="founder-note" aria-hidden="true">ESTRATEGIA<br />CON CARA HUMANA</span>
  </div>

  <div class="founder-picker" role="group" aria-label="Elige una expresión">
    {expressions.map((expression, index) => (
      <button
        type="button"
        aria-label={`Mostrar expresión: ${expression.label}`}
        aria-pressed={index === 0 ? 'true' : 'false'}
        data-founder-expression
        data-src={expression.src}
        data-alt={expression.alt}
        data-label={expression.label}
        data-caption={expression.caption}
        data-number={String(index + 1).padStart(2, '0')}
      >
        <img src={expression.src} alt="" width="44" height="44" loading="lazy" decoding="async" />
      </button>
    ))}
  </div>

  <figcaption class="founder-caption">
    <div aria-live="polite" aria-atomic="true">
      <strong data-founder-label>{initial.label}</strong>
      <p data-founder-message>{initial.caption}</p>
    </div>
    <span aria-hidden="true">TOCA UNA CARA ↗</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-founder-gallery]').forEach((gallery) => {
    const image = gallery.querySelector<HTMLImageElement>('[data-founder-image]');
    const label = gallery.querySelector<HTMLElement>('[data-founder-label]');
    const message = gallery.querySelector<HTMLElement>('[data-founder-message]');
    const count = gallery.querySelector<HTMLElement>('[data-founder-count]');
    const picker = gallery.querySelector<HTMLElement>('.founder-picker');
    const buttons = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-founder-expression]'));

    if (!image || !label || !message || !count || !picker || !buttons.length) return;

    const selectExpression = (button: HTMLButtonElement) => {
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));

      if (image.getAttribute('src') !== button.dataset.src) {
        image.classList.remove('is-changing');
        void image.offsetWidth;
        image.src = button.dataset.src ?? image.src;
        image.alt = button.dataset.alt ?? '';
        image.classList.add('is-changing');
      }

      label.textContent = button.dataset.label ?? '';
      message.textContent = button.dataset.caption ?? '';
      count.textContent = `${button.dataset.number} — 07`;
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => selectExpression(button));
    });

    picker.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const currentIndex = buttons.indexOf(document.activeElement as HTMLButtonElement);
      const fallbackIndex = Math.max(0, currentIndex);
      const nextIndex = event.key === 'Home'
        ? 0
        : event.key === 'End'
          ? buttons.length - 1
          : (fallbackIndex + (event.key === 'ArrowLeft' ? -1 : 1) + buttons.length) % buttons.length;
      buttons[nextIndex].focus();
    });
  });
</script>

<style>
  .founder-gallery {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    padding: 1rem;
    overflow: hidden;
    background: var(--yellow);
    color: var(--ink);
    isolation: isolate;
  }

  .founder-gallery::before {
    content: "";
    position: absolute;
    z-index: -1;
    width: 180px;
    height: 180px;
    right: -70px;
    bottom: 12%;
    border-radius: 50%;
    background: var(--red);
  }

  .founder-gallery-top,
  .founder-caption > span,
  .founder-window-label,
  .founder-note {
    font-size: .55rem;
    font-weight: 900;
    letter-spacing: .09em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .founder-gallery-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .founder-stage {
    position: relative;
    display: grid;
    min-height: 430px;
    margin: .85rem 0;
    padding: 1.6rem 1rem 2.4rem;
    overflow: hidden;
    place-items: center;
    background: var(--mint);
  }

  .founder-stage::before,
  .founder-stage::after {
    content: "";
    position: absolute;
    border: 1px solid rgb(13 21 18 / 38%);
    border-radius: 50%;
  }

  .founder-stage::before {
    width: 120%;
    height: 48%;
    transform: rotate(-18deg);
  }

  .founder-stage::after {
    width: 88%;
    height: 70%;
    transform: rotate(44deg);
  }

  .founder-orbit {
    position: absolute;
    width: 82%;
    aspect-ratio: 1;
    border: 1px dashed rgb(13 21 18 / 45%);
    border-radius: 50%;
    transform: scaleY(.62) rotate(-25deg);
  }

  .founder-spark {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    color: var(--red);
    font-size: 2.4rem;
    transform: rotate(16deg);
  }

  .founder-window {
    position: relative;
    z-index: 2;
    width: min(78%, 330px);
    padding: .45rem .45rem 0;
    background: #f6f0e5;
    transform: rotate(-1.5deg);
  }

  .founder-window-label {
    display: block;
    padding: .25rem .15rem .5rem;
  }

  .founder-window img {
    display: block;
    width: 100%;
    height: 355px;
    object-fit: contain;
    object-position: center bottom;
  }

  .founder-window img.is-changing {
    animation: founder-swap .33s ease-out both;
  }

  .founder-note {
    position: absolute;
    right: .9rem;
    bottom: .8rem;
    z-index: 3;
    padding: .42rem .55rem;
    background: var(--ink);
    color: white;
    text-align: right;
  }

  .founder-picker {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: .35rem;
  }

  .founder-picker button {
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    background: #f6f0e5;
    cursor: pointer;
  }

  .founder-picker button:hover {
    border-color: var(--ink);
  }

  .founder-picker button[aria-pressed="true"] {
    border-color: var(--red);
  }

  .founder-picker img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 32%;
  }

  .founder-caption {
    display: grid;
    margin-top: .85rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem;
  }

  .founder-caption strong {
    display: block;
    margin-bottom: .25rem;
    color: var(--red);
    font-size: .65rem;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .founder-caption p {
    max-width: 390px;
    margin: 0;
    font-size: .82rem;
    line-height: 1.4;
  }

  .founder-caption > span {
    padding-bottom: .15rem;
    white-space: nowrap;
  }

  @keyframes founder-swap {
    from {
      opacity: .45;
      transform: translateY(7px) scale(.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 600px) {
    .founder-gallery {
      padding: .75rem;
    }

    .founder-stage {
      min-height: 365px;
      padding-inline: .4rem;
    }

    .founder-window {
      width: min(82%, 280px);
    }

    .founder-window img {
      height: 300px;
    }

    .founder-picker {
      gap: .25rem;
    }

    .founder-caption {
      grid-template-columns: 1fr;
      gap: .5rem;
    }
  }
</style>
