---
import Header from './Header.astro';
import SiteFooter from './SiteFooter.astro';
import MainLayout from '../layouts/MainLayout.astro';
import BlogCard from './BlogCard.astro';
import PriceCard from './PriceCard.astro';
import { BUSINESS_EMAIL, SITE_NAME } from '../site';

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  intro: string;
  serviceType: string;
  tag: string;
  tone: string;
  outcomes: { title: string; text: string }[];
  deliverables: string[];
  process: { title: string; text: string }[];
  faqs: { question: string; answer: string }[];
  posts: any[];
  plans?: any[];
  pricingHeading?: string;
  pricingIntro?: string;
  note?: { title: string; text: string; href: string; cta: string };
}
const { title, metaTitle, description, intro, serviceType, tag, tone, outcomes, deliverables, process, faqs, posts, plans = [], pricingHeading = 'Planes y precios', pricingIntro, note } = Astro.props;
const schema = {
  '@type': 'Service',
  name: title,
  serviceType,
  description,
  provider: { '@type': 'Organization', name: SITE_NAME, email: BUSINESS_EMAIL },
  inLanguage: 'es-CL',
};
---
<MainLayout title={metaTitle} description={description} schema={schema}>
  <div id="top" class="site-shell">
    <Header />
    <main id="contenido">
      <section class={`service-hero service-hero-${tone} section-pad`}>
        <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/servicios/">Servicios</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
        <div class="service-hero-grid"><div><p class="eyebrow"><span class="status-dot"></span> {tag}</p><h1>{title}</h1><p class="service-intro">{intro}</p><div class="hero-actions"><a class="button button-primary" href="/contacto/">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a><a class="text-link" href="/precios/">Ver precios <span aria-hidden="true">↓</span></a></div></div><div class="service-hero-art" aria-hidden="true"><span class="service-hero-shape">✳</span><span class="service-hero-word">RDS<br />/ {tag.split(' ')[0]}</span><span class="service-hero-caption">PENSADO<br />PARA CRECER ↗</span></div></div>
      </section>
      <section class="service-value section-pad"><div class="section-heading heading-split"><div><p class="eyebrow eyebrow-dark">¿QUÉ CAMBIA?</p><h2>Una solución conectada con lo que tu negocio necesita.</h2></div><p class="section-intro">El punto de partida no es una plantilla. Es entender qué tiene que comunicar este servicio y cómo sabremos que quedó listo.</p></div><div class="outcome-grid">{outcomes.map((item, index) => <article class="outcome-card"><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
      <section class="deliverables-section section-pad"><div><p class="eyebrow">EL TRABAJO, EN CLARO</p><h2>¿Qué puede incluir?</h2><p class="section-intro">El alcance exacto queda definido en la propuesta antes de empezar.</p></div><ul class="deliverables-list">{deliverables.map((item) => <li><span aria-hidden="true">✳</span>{item}</li>)}</ul></section>
      {note && <section class="service-note section-pad"><div><p class="eyebrow eyebrow-dark">IMPORTANTE</p><h2>{note.title}</h2><p>{note.text}</p></div><a class="button button-ink" href={note.href}>{note.cta} <span aria-hidden="true">↗</span></a></section>}
      {plans.length > 0 && <section class="service-pricing section-pad"><div class="section-heading"><p class="eyebrow eyebrow-dark">{pricingHeading.toUpperCase()}</p><h2>{pricingHeading}</h2>{pricingIntro && <p class="section-intro">{pricingIntro}</p>}</div><div class="pricing-grid">{plans.map((plan, index) => <PriceCard plan={plan} tone={index % 3 === 1 ? 'orange' : index % 3 === 2 ? 'mint' : 'lilac'} />)}</div></section>}
      <section class="service-process section-pad"><div class="section-heading"><p class="eyebrow eyebrow-dark">CÓMO TRABAJAMOS</p><h2>Avanzamos por pasos que puedes revisar.</h2></div><div class="process-grid">{process.map((item, index) => <article class="process-card"><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
      <section class="faq-section section-pad"><div class="section-heading"><p class="eyebrow eyebrow-dark">PREGUNTAS FRECUENTES</p><h2>Antes de empezar, aclaremos esto.</h2></div><div class="faq-list">{faqs.map((item) => <details><summary>{item.question}<span aria-hidden="true">＋</span></summary><p>{item.answer}</p></details>)}</div></section>
      {posts.length > 0 && <section class="related-section section-pad"><div class="section-heading heading-split"><div><p class="eyebrow eyebrow-dark">SIGUE EXPLORANDO</p><h2>Lecturas relacionadas.</h2></div><a class="text-link" href="/blog/">Ver todas <span aria-hidden="true">↗</span></a></div><div class="blog-grid">{posts.map((post, index) => <BlogCard slug={post.id} title={post.data.title} description={post.data.description} category={post.data.category} publishDate={post.data.publishDate} readingTime={post.data.readingTime} tone={index === 1 ? 'lilac' : 'mint'} />)}</div></section>}
      <section class="contact-band section-pad"><p class="eyebrow">EMPECEMOS POR UNA CONVERSACIÓN</p><h2>¿Es el servicio que<br />necesitas?</h2><a class="button button-paper" href="/contacto/">Cuéntame qué buscas <span aria-hidden="true">↗</span></a><span class="contact-spark" aria-hidden="true">✳</span></section>
    </main>
    <SiteFooter />
  </div>
</MainLayout>
