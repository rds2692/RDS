---
import type { FaqItem } from '../data/faqs';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---
<div class="faq-list">
  {items.map((item) => (
    <details id={`faq-${item.id}`}>
      <summary>{item.question}<span aria-hidden="true">＋</span></summary>
      <div class="faq-answer">
        <p>{item.answer}</p>
        {item.link && <a class="text-link" href={item.link.href}>{item.link.label} <span aria-hidden="true">↗</span></a>}
      </div>
    </details>
  ))}
</div>
