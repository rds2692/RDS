---
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { BUSINESS_EMAIL, BUSINESS_PHONE, WHATSAPP_URL } from '../../site';

const description = 'Conversemos sobre tu web, SEO o estrategia digital. Cuéntame brevemente qué quieres resolver y revisa la consulta antes de enviarla por correo.';
const service = Astro.url.searchParams.get('servicio') || '';
const selectedService = /página.*local|seo local/i.test(service)
  ? 'local'
  : /^web/i.test(service)
    ? 'web'
    : /auditoría|implementación|presence|growth|authority|geo|seo/i.test(service)
      ? 'seo'
      : '';
const contactOptions = [
  { value: 'web', label: 'Crear o renovar mi sitio web' },
  { value: 'seo', label: 'Mejorar mi sitio y su posicionamiento' },
  { value: 'local', label: 'Trabajar mi SEO local' },
  { value: 'orientacion', label: 'Necesito orientación / Otro' },
];
const schema = { '@type': 'ContactPage', name: 'Contacto Rangel Designs Studio', description, inLanguage: 'es-CL' };
---
<MainLayout title="Contacto | Hablemos de tu proyecto | RDS" description={description} schema={schema}>
  <div id="top" class="site-shell"><Header /><main id="contenido">
    <section class="contact-page section-pad"><nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><span aria-current="page">Contacto</span></nav><div class="contact-page-grid"><div><h1>Empecemos por una <span>buena pregunta.</span></h1><p class="directory-intro">Cuéntame qué hace tu negocio, qué quieres mejorar y si tienes una fecha importante. La información se enviará desde tu programa de correo; el sitio no guarda los datos del formulario.</p><div class="contact-direct-channels"><a class="email-direct" href={`mailto:${BUSINESS_EMAIL}`}>{BUSINESS_EMAIL} ↗</a>{BUSINESS_PHONE && <a href={`tel:${BUSINESS_PHONE.replaceAll(' ', '')}`}>{BUSINESS_PHONE}</a>}{WHATSAPP_URL && <a href={WHATSAPP_URL}>WhatsApp ↗</a>}</div></div><a class="contact-prompt" href="#formulario"><span class="prompt-doodle" aria-hidden="true">✳</span><h2>¿Qué ayuda a preparar la conversación?</h2><ul><li>Qué hace tu negocio y dónde presta servicios</li><li>Qué quieres crear o mejorar</li><li>Qué tecnología o plataforma usas, si ya tienes web</li><li>Qué fecha importante tienes, si existe</li></ul><span class="card-link-label">Ir al formulario <span aria-hidden="true">↗</span></span></a></div></section>
    <section class="contact-form-section section-pad" id="formulario"><div class="contact-form-heading"><h2>Lo ordenamos desde el primer mensaje.</h2><p>Los campos con * son necesarios. Al enviar, revisa el correo que se prepara y pulsa Enviar.</p></div><form class="project-form" action={`mailto:${BUSINESS_EMAIL}`} method="post" enctype="text/plain" data-contact-form data-email={BUSINESS_EMAIL}>
      <input type="hidden" name="Detalle del servicio" value={service} />
      <div class="form-field"><label for="contact-name">Nombre *</label><input id="contact-name" name="Nombre" autocomplete="name" required /></div>
      <div class="form-field"><label for="contact-business">Empresa</label><input id="contact-business" name="Empresa" autocomplete="organization" /></div>
      <div class="form-field"><label for="contact-email">Correo *</label><input id="contact-email" name="Correo" type="email" autocomplete="email" required /></div>
      <div class="form-field"><label for="contact-phone">Teléfono o WhatsApp</label><input id="contact-phone" name="Teléfono o WhatsApp" type="tel" autocomplete="tel" /></div>
      <div class="form-field form-field-wide"><label for="contact-service">¿Qué necesitas?</label><select id="contact-service" name="Necesidad"><option value="">Selecciona una opción</option>{contactOptions.map((option) => <option value={option.label} selected={selectedService === option.value}>{option.label}</option>)}</select></div>
      <div class="form-field form-field-wide"><label for="contact-message">¿Qué necesitas resolver? *</label><textarea id="contact-message" name="Mensaje" rows="5" required></textarea></div>
      <div class="form-submit form-field-wide"><button class="button button-ink" type="submit">Preparar correo <span aria-hidden="true">↗</span></button><div><p id="contact-status" aria-live="polite">Se abrirá tu aplicación de correo para revisar y enviar el mensaje.</p><a class="text-link" href="/privacidad/">Cómo se tratan los datos <span aria-hidden="true">↗</span></a></div></div>
    </form></section>
    <section class="contact-bottom section-pad"><div><a href="/servicios/">Servicios <span>↗</span></a><a href="/precios/">Precios <span>↗</span></a><a href="/proyectos/">Proyectos <span>↗</span></a><a href="/preguntas-frecuentes/">Preguntas frecuentes <span>↗</span></a><a href="/blog/">Ideas del estudio <span>↗</span></a></div></section>
  </main><SiteFooter /></div>
  <script>
    const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const status = document.querySelector<HTMLElement>('#contact-status');
    contactForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!contactForm.reportValidity()) return;
      const fields = new FormData(contactForm);
      const subject = `Consulta RDS: ${fields.get('Necesidad') || 'Proyecto digital'}`;
      const body = [...fields.entries()].map(([key, value]) => `${key}: ${value}`).join('\n');
      status && (status.textContent = 'Tu aplicación de correo debería abrirse ahora. Revisa los datos y pulsa Enviar para completar el contacto.');
      const analyticsWindow = window as Window & { dataLayer?: unknown[] };
      analyticsWindow.dataLayer?.push({ event: 'contact_mailto_opened', contact_need: fields.get('Necesidad') || 'Sin seleccionar' });
      const email = contactForm.dataset.email;
      if (email) window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</MainLayout>
