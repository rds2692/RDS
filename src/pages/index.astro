---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BlogCard from '../components/BlogCard.astro';
import PriceCard from '../components/PriceCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import FounderExpressions from '../components/FounderExpressions.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { SERVICES, SITE_DESCRIPTION, SITE_NAME } from '../site';
import { AUDIT, MONTHLY_PLANS, WEB_PLANS, formatCLP } from '../data/pricing';
import { FEATURED_FAQS } from '../data/faqs';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const schema = [
  {
    '@type': 'WebPage',
    name: 'Diseño web, SEO y estrategia digital | Rangel Designs Studio',
    description: SITE_DESCRIPTION,
    inLanguage: 'es-CL',
    about: { '@type': 'Organization', name: SITE_NAME },
  },
];
---
<MainLayout title="Diseño Web y SEO en Santiago | Rangel Designs Studio" description={SITE_DESCRIPTION} schema={schema} includeOrganization={true}>
  <div id="top" class="site-shell">
    <Header />
    <main id="contenido">
      <section class="hero-section section-pad" aria-labelledby="hero-title">
        <canvas class="hero-scene" data-hero-scene aria-hidden="true"></canvas>
        <div class="hero-editorial">
          <div class="hero-kicker" aria-hidden="true">
            <span>RDS® / ESTUDIO DIGITAL</span>
            <span>CHILE + LATINOAMÉRICA</span>
          </div>
          <h1 id="hero-title" class="sr-only">RDS: diseño web, SEO y presencia digital para negocios que quieren ser encontrados.</h1>
          <div class="hero-wordmark" data-hero-intro aria-hidden="true">R<span class="hero-wordmark-orb">D</span>S</div>
          <p class="hero-tagline" data-hero-intro>HACEMOS MARCAS QUE SE VEN.<br /><span>Y SE ENCUENTRAN.</span></p>
          <p class="hero-subline" data-hero-intro aria-hidden="true">DISEÑO WEB <i>✳</i> POSICIONAMIENTO SEO <i>✳</i> CONTENIDO PARA IA</p>
          <p class="hero-description" data-hero-intro>Diseñamos y desarrollamos sitios con estrategia, personalidad y una estructura preparada para que tu negocio sea comprendido, recordado y encontrado.</p>
          <div class="hero-actions" data-hero-intro>
            <a class="button button-red" href="/contacto/">CUÉNTAME TU PROYECTO <span aria-hidden="true">↗</span></a>
            <a class="text-link text-link-light" href="#servicios">VER LO QUE HACEMOS <span aria-hidden="true">↓</span></a>
          </div>
          <span class="hero-scene-hint" aria-hidden="true"><i></i> ESCENA WEBGL / MUEVE EL CURSOR</span>
          <span class="hero-asterisk hero-asterisk-one" aria-hidden="true">✳</span>
          <span class="hero-asterisk hero-asterisk-two" aria-hidden="true">✳</span>
        </div>
        <div class="hero-note"><span>ESTRATEGIA / 01</span><span>DISEÑO / 02</span><span>DESARROLLO / 03</span><span>VISIBILIDAD / 04</span></div>
      </section>

      <section class="problem-section manifesto-section section-pad" aria-labelledby="problem-title">
        <div class="manifesto-intro">
          <FounderExpressions />
          <div class="manifesto-copy">
            <p class="eyebrow eyebrow-dark">QUIÉNES SOMOS / RDS</p>
            <h2 id="problem-title">UNA WEB CLARA<br />ES UN <span>BUEN NEGOCIO.</span></h2>
            <p class="section-intro">RDS une diseño, desarrollo y visibilidad para que tu negocio no solo exista en internet: se entienda, se recuerde y se encuentre.</p>
            <p class="manifesto-signature">Una estrategia puede ser rigurosa sin dejar de tener personalidad y una cara humana.</p>
            <a class="text-link" href="/estudio/">Conoce cómo trabajamos <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="discipline-grid" aria-label="Cómo trabaja RDS">
          <a class="discipline-card discipline-yellow" href="/estudio/"><span class="discipline-index">01 / ESCUCHA</span><span class="discipline-art" aria-hidden="true"><i>?</i><b>PIENSA</b></span><h3>Entendemos antes de diseñar.</h3><p>Objetivos, audiencia y contexto primero.</p><span class="card-link-label">Cómo trabajamos <span aria-hidden="true">↗</span></span></a>
          <a class="discipline-card discipline-orange" href="/contacto/"><span class="discipline-index">02 / ESTRATEGIA</span><span class="discipline-art" aria-hidden="true"><i>↗</i><b>RUTA</b></span><h3>Definimos qué debe lograr cada página.</h3><p>Una estructura que guía al siguiente paso.</p><span class="card-link-label">Conversemos <span aria-hidden="true">↗</span></span></a>
          <a class="discipline-card discipline-red" href="/diseno-web/"><span class="discipline-index">03 / DISEÑO</span><span class="discipline-art" aria-hidden="true"><i>✳</i><b>MARCA</b></span><h3>Hacemos que tu negocio se sienta propio.</h3><p>Personalidad visual, claridad y jerarquía.</p><span class="card-link-label">Ver diseño web <span aria-hidden="true">↗</span></span></a>
          <a class="discipline-card discipline-blue" href="/diseno-web/"><span class="discipline-index">04 / CÓDIGO</span><span class="discipline-art" aria-hidden="true"><i>&lt;/&gt;</i><b>WEB</b></span><h3>Construimos una experiencia sólida.</h3><p>Rápida, responsive y preparada para crecer.</p><span class="card-link-label">Explorar desarrollo <span aria-hidden="true">↗</span></span></a>
          <a class="discipline-card discipline-mint" href="/seo/"><span class="discipline-index">05 / SEO</span><span class="discipline-art" aria-hidden="true"><i>⌕</i><b>HALLA</b></span><h3>Conectamos lo que haces con lo que buscan.</h3><p>Contenido y técnica trabajando juntos.</p><span class="card-link-label">Ver planes SEO <span aria-hidden="true">↗</span></span></a>
          <a class="discipline-card discipline-lilac" href="/seo-ia/"><span class="discipline-index">06 / IA</span><span class="discipline-art" aria-hidden="true"><i>∞</i><b>GEO</b></span><h3>Preparamos la información para nuevas búsquedas.</h3><p>Claridad útil para personas y asistentes.</p><span class="card-link-label">Explorar GEO + AEO <span aria-hidden="true">↗</span></span></a>
        </div>
      </section>

      <section class="services-section section-pad" id="servicios" aria-labelledby="services-title">
        <div class="section-heading centered-heading">
          <p class="eyebrow eyebrow-dark">NUESTRO TRABAJO / SERVICIOS</p>
          <h2 id="services-title">DISEÑO WEB.<br /><span>SEO. PRESENCIA.</span></h2>
          <p class="section-intro">Cada servicio se conecta con un objetivo de negocio. Elige un punto de partida o conversemos para definir el correcto.</p>
          <a class="text-link" href="/servicios/">Explorar todos los servicios <span aria-hidden="true">↗</span></a>
        </div>
        <div class="services-grid">
          {SERVICES.map((service) => <ServiceCard {...service} href={service.slug} />)}
        </div>
      </section>

      <section class="local-directory-section section-pad" aria-labelledby="local-directory-title">
        <div class="section-heading heading-split">
          <div><p class="eyebrow eyebrow-dark">DISEÑO WEB EN SANTIAGO</p><h2 id="local-directory-title">Proyectos para empresas de la Región Metropolitana.</h2></div>
          <p class="section-intro">Explora las comunas donde RDS atiende proyectos. Cada página describe un contexto distinto y la modalidad real de trabajo.</p>
        </div>
        <div class="nearby-area-grid">
          <a href="/diseno-web-santiago/"><span>HUB / SANTIAGO</span><strong>Diseño web en Santiago</strong><i aria-hidden="true">↗</i></a>
          <a href="/diseno-web-santiago/providencia/"><span>ZONA ORIENTE</span><strong>Providencia</strong><i aria-hidden="true">↗</i></a>
          <a href="/diseno-web-santiago/las-condes/"><span>ZONA ORIENTE</span><strong>Las Condes</strong><i aria-hidden="true">↗</i></a>
          <a href="/diseno-web-santiago/nunoa/"><span>SANTIAGO</span><strong>Ñuñoa</strong><i aria-hidden="true">↗</i></a>
          <a href="/diseno-web-santiago/maipu/"><span>ZONA PONIENTE</span><strong>Maipú</strong><i aria-hidden="true">↗</i></a>
          <a href="/diseno-web-santiago/puente-alto/"><span>ZONA SUR</span><strong>Puente Alto</strong><i aria-hidden="true">↗</i></a>
        </div>
      </section>

      <section class="business-paths section-pad" aria-labelledby="paths-title">
        <div class="section-heading"><p class="eyebrow eyebrow-dark">DOS FORMAS DE TRABAJAR JUNTOS</p><h2 id="paths-title">¿Necesitas una web nueva o mejorar la que ya tienes?</h2></div>
        <div class="path-grid">
          <a class="path-card path-new" href="/diseno-web/"><span class="problem-number">LÍNEA A / WEB + VISIBILITY</span><span class="path-doodle" aria-hidden="true">✳</span><h3>Necesito un sitio web.</h3><p>Diseñamos y desarrollamos tu sitio con una base SEO inicial. Puedes sumar posicionamiento mensual después del lanzamiento.</p><span class="text-link">Ver paquetes web <span aria-hidden="true">↗</span></span></a>
          <a class="path-card path-existing" href="/auditoria-seo/"><span class="problem-number">LÍNEA B / SEARCH + AI GROWTH</span><span class="path-doodle" aria-hidden="true">⌕</span><h3>Ya tengo una web.</h3><p>Primero auditamos la plataforma y sus riesgos. Luego cotizamos las mejoras aprobadas y, si te sirve, el trabajo mensual.</p><span class="text-link">Conocer la auditoría <span aria-hidden="true">↗</span></span></a>
        </div>
      </section>

      <section class="method-section section-pad" aria-labelledby="method-title">
        <div class="method-intro"><p class="eyebrow eyebrow-dark">UN PROCESO CLARO, DE PRINCIPIO A FIN</p><h2 id="method-title">De la idea al sitio que puedes hacer crecer.</h2><p>Sabes qué estamos haciendo, por qué lo hacemos y qué viene después.</p><a class="button button-ink" href="/estudio/">Conoce el estudio <span aria-hidden="true">↗</span></a></div>
        <div class="method-steps">
          <a class="method-step" href="/contacto/"><span>01</span><div><h3>Conversamos</h3><p>Entendemos el negocio, sus objetivos, la audiencia y el estado del sitio.</p><span class="card-link-label">Hablemos de tu proyecto <span aria-hidden="true">↗</span></span></div><span class="step-mark" aria-hidden="true">↗</span></a>
          <a class="method-step" href="/contacto/"><span>02</span><div><h3>Definimos</h3><p>Acordamos estructura, alcance, entregables y medición antes de empezar.</p><span class="card-link-label">Definir una propuesta <span aria-hidden="true">↗</span></span></div><span class="step-mark" aria-hidden="true">↗</span></a>
          <a class="method-step" href="/servicios/"><span>03</span><div><h3>Diseñamos o auditamos</h3><p>Construimos una web nueva o diagnosticamos la existente antes de intervenirla.</p><span class="card-link-label">Explorar servicios <span aria-hidden="true">↗</span></span></div><span class="step-mark" aria-hidden="true">↗</span></a>
          <a class="method-step" href="/seo/"><span>04</span><div><h3>Publicamos y evolucionamos</h3><p>Probamos los cambios aprobados y, si lo contratas, continuamos con posicionamiento mensual.</p><span class="card-link-label">Ver posicionamiento mensual <span aria-hidden="true">↗</span></span></div><span class="step-mark" aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="home-faq-section section-pad" aria-labelledby="home-faq-title">
        <div class="section-heading centered-heading">
          <p class="eyebrow eyebrow-dark">RESPUESTAS ANTES DE EMPEZAR</p>
          <h2 id="home-faq-title">Preguntas frecuentes</h2>
          <p class="section-intro">Precio, plazos, SEO, cobertura y propiedad del sitio: lo que conviene aclarar antes de contratar un proyecto.</p>
        </div>
        <div class="home-faq-list">
          <FaqAccordion items={FEATURED_FAQS} />
        </div>
        <a class="button button-ink section-end-button" href="/preguntas-frecuentes/">Ver todas las preguntas <span aria-hidden="true">↗</span></a>
      </section>

      <section class="home-plans section-pad" id="precios" aria-labelledby="web-plans-title">
        <div class="section-heading heading-split"><div><p class="eyebrow eyebrow-dark">LÍNEA A / PAGO ÚNICO</p><h2 id="web-plans-title">Elige el tamaño de tu nueva web.</h2></div><a class="text-link" href="/precios/">Ver todos los precios <span aria-hidden="true">↗</span></a></div>
        <div class="home-price-grid">{WEB_PLANS.map((plan, index) => <PriceCard plan={plan} tone={index === 1 ? 'orange' : index === 2 ? 'mint' : 'lilac'} compact={true} />)}</div>
        <div class="section-heading monthly-heading"><div><p class="eyebrow eyebrow-dark">LÍNEA B / MENSUAL</p><h2>Haz crecer la visibilidad de tu sitio.</h2><p class="section-intro">Los planes mensuales son independientes del desarrollo y comienzan después de revisar y preparar el sitio.</p></div></div>
        <div class="home-price-grid">{MONTHLY_PLANS.map((plan, index) => <PriceCard plan={plan} tone={index === 1 ? 'orange' : index === 2 ? 'mint' : 'lilac'} compact={true} />)}</div>
        <div class="audit-strip"><div><p class="eyebrow eyebrow-dark">¿SITIO CONSTRUIDO POR OTRO EQUIPO?</p><h3>{AUDIT.name}: {formatCLP(AUDIT.amount)}</h3><p>Diagnóstico independiente antes de definir las correcciones. La implementación se cotiza por separado.</p></div><a class="button button-ink" href="/auditoria-seo/">Ver qué incluye <span aria-hidden="true">↗</span></a></div>
      </section>

      <section class="project-teaser section-pad" aria-labelledby="project-teaser-title"><a class="project-teaser-art" href="/proyectos/" aria-label="Conocer cómo RDS presenta sus proyectos"><span>RDS /</span><i>✳</i><b>REAL<br />WORK<br />ONLY</b><span class="card-link-label">Ver proyectos <span aria-hidden="true">↗</span></span></a><div><p class="eyebrow eyebrow-dark">PROYECTOS Y CASOS DE ESTUDIO</p><h2 id="project-teaser-title">El trabajo se muestra con contexto y permiso.</h2><p>Publicamos casos con autorización, capturas reales y resultados que se pueden comprobar. Sin clientes inventados ni métricas de adorno.</p><a class="text-link" href="/proyectos/">Cómo contamos cada proyecto <span aria-hidden="true">↗</span></a></div></section>

      <section class="blog-section section-pad" aria-labelledby="blog-title">
        <div class="section-heading heading-split">
          <div><p class="eyebrow eyebrow-dark">EL CUADERNO DEL ESTUDIO</p><h2 id="blog-title">Ideas para construir una mejor presencia digital.</h2></div>
          <a class="text-link" href="/blog/">Ir al blog <span aria-hidden="true">↗</span></a>
        </div>
        <div class="blog-grid">
          {posts.map((post, index) => <BlogCard slug={post.id} title={post.data.title} description={post.data.description} category={post.data.category} publishDate={post.data.publishDate} readingTime={post.data.readingTime} tone={index === 1 ? 'lilac' : index === 2 ? 'yellow' : 'mint'} />)}
        </div>
      </section>

      <section class="price-teaser section-pad" aria-labelledby="price-title">
        <div class="price-orbit" aria-hidden="true"><span>✳</span><i></i></div>
        <div><p class="eyebrow eyebrow-dark">SEO LOCAL / ALCANCE REAL</p><h2 id="price-title">Una página por zona.<br /><span>Con algo útil que decir.</span></h2><p>Los paquetes de páginas locales se calculan por cantidad y se crean solo para zonas donde el negocio realmente presta servicios.</p></div>
        <a class="button button-ink" href="/seo-local/">Ver paquetes locales <span aria-hidden="true">↗</span></a>
      </section>

      <section class="contact-band section-pad" aria-labelledby="contact-title">
        <p class="eyebrow">¿LISTO PARA DAR EL SIGUIENTE PASO?</p><h2 id="contact-title">Hagamos que tu web<br />trabaje mejor.</h2><a class="button button-paper" href="/contacto/">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a><span class="contact-spark" aria-hidden="true">✳</span>
      </section>
    </main>
    <SiteFooter />
  </div>
  <script>
    const loadHeroScene = () => import('../scripts/hero-scene');
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(loadHeroScene, { timeout: 900 });
    } else {
      window.setTimeout(loadHeroScene, 120);
    }
  </script>
  <style>
    .manifesto-intro {
      display: grid;
      max-width: 1360px;
      margin: 0 auto 12px;
      padding-block: clamp(1rem, 3vw, 3rem);
      grid-template-columns: minmax(360px, .9fr) minmax(0, 1.1fr);
      align-items: center;
      gap: clamp(2rem, 7vw, 7rem);
    }

    .manifesto-copy h2 {
      max-width: 780px;
      margin-bottom: 1.4rem;
      font-size: clamp(2.6rem, 5.7vw, 6.1rem);
      line-height: .88;
    }

    .manifesto-copy .section-intro {
      max-width: 660px;
      margin-bottom: 1.1rem;
    }

    .manifesto-signature {
      max-width: 570px;
      margin-bottom: 1.35rem;
      padding-left: 1rem;
      border-left: 4px solid var(--red);
      font-size: .95rem;
      font-weight: 700;
      line-height: 1.5;
    }

    @media (max-width: 1000px) {
      .manifesto-intro {
        max-width: 760px;
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
    }

    @media (max-width: 600px) {
      .manifesto-intro {
        grid-template-columns: minmax(0, 1fr);
      }

      .manifesto-copy h2 {
        font-size: clamp(2.45rem, 11vw, 3.8rem);
      }
    }
  </style>
</MainLayout>
