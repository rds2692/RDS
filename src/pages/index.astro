---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BlogCard from '../components/BlogCard.astro';
import PriceCard from '../components/PriceCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CharacterPortrait from '../components/CharacterPortrait.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { SERVICES, SITE_DESCRIPTION, SITE_NAME } from '../site';
import { AUDIT, MONTHLY_PLANS, WEB_PLANS, formatCLP } from '../data/pricing';
import { FEATURED_FAQS } from '../data/faqs';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const schema = [
  {
    '@type': 'WebPage',
    name: 'Diseño web, SEO y estrategia digital | Rangel Designs Studio',
    description: SITE_DESCRIPTION,
    inLanguage: 'es-CL',
    about: { '@type': 'Organization', name: SITE_NAME },
  },
];
---
<MainLayout title="Diseño Web y SEO en Santiago | Rangel Designs Studio" description={SITE_DESCRIPTION} schema={schema} includeOrganization={true}>
  <div id="top" class="site-shell">
    <Header />
    <main id="contenido">
      <section class="hero-split-section section-pad" aria-labelledby="hero-title">
        <div class="hero-split-layout">
          <div class="hero-split-copy">
            <h1 id="hero-title">HACEMOS MARCAS<br />QUE SE VEN.<br /><span>Y SE ENCUENTRAN.</span></h1>
            <p class="hero-split-subline">DISEÑO WEB <i>✳</i> POSICIONAMIENTO SEO <i>✳</i> CONTENIDO PARA IA</p>
            <p class="hero-split-description">Diseñamos y desarrollamos sitios con estrategia, personalidad y una estructura preparada para que tu negocio sea comprendido, recordado y encontrado.</p>
            <div class="hero-split-actions">
              <a class="button button-red" href="/contacto/">CUÉNTAME TU PROYECTO <span aria-hidden="true">↗</span></a>
              <a class="text-link" href="#servicios">VER LO QUE HACEMOS <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <div class="hero-split-visual">
            <span class="hero-split-spark" aria-hidden="true">✳</span>
            <div class="hero-image-frame">
              <img src="/images/armando/expresion-02.webp" alt="Armando Rangel riendo con entusiasmo" width="357" height="360" fetchpriority="high" />
            </div>
            <div class="hero-visual-caption"><strong>Conversemos de tu proyecto.</strong></div>
          </div>
        </div>
      </section>

      <section class="problem-section manifesto-section section-pad" aria-labelledby="problem-title">
        <div class="manifesto-intro">
          <CharacterPortrait
            src="/images/armando/expresion-01.webp"
            alt="Armando Rangel con una expresión tranquila y sonriente"
            caption="Primero entendemos el proyecto. Después movemos una sola pieza."
            tone="sage"
          />
          <div class="manifesto-copy">
            <h2 id="problem-title">UNA WEB CLARA<br />ES UN <span>BUEN NEGOCIO.</span></h2>
            <p class="section-intro">RDS une diseño, desarrollo y visibilidad para que tu negocio no solo exista en internet: se entienda, se recuerde y se encuentre.</p>
            <p class="manifesto-signature">Una estrategia puede ser rigurosa sin dejar de tener personalidad y una cara humana.</p>
            <a class="text-link" href="/estudio/">Conoce cómo trabajamos <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="discipline-grid" aria-label="Cómo trabaja RDS">
          <a class="discipline-card discipline-yellow" href="/estudio/"><span class="discipline-art" aria-hidden="true"><i>?</i><b>PIENSA</b></span><h3>Entendemos antes de diseñar.</h3><p>Objetivos, audiencia y contexto primero.</p><span class="card-link-label">Cómo trabajamos <span aria-hidden="true">↗</span></span></a>
          <a class="discipline-card discipline-orange" href="/contacto/"><span class="discipline-art" aria-hidden="true"><i>↗</i><b>RUTA</b></span><h3>Definimos qué debe lograr cada página.</h3><p>Una estructura que guía al siguiente paso.</p><span class="card-link-label">Conversemos <span aria-hidden="true">↗</span></span></a>
          <a class="discipline-card discipline-red" href="/diseno-web/"><span class="discipline-art" aria-hidden="true"><i>✳</i><b>MARCA</b></span><h3>Hacemos que tu negocio se sienta propio.</h3><p>Personalidad visual, claridad y jerarquía.</p><span class="card-link-label">Ver diseño web <span aria-hidden="true">↗</span></span></a>
          <a class="discipline-card discipline-blue" href="/diseno-web/"><span class="discipline-art" aria-hidden="true"><i>&lt;/&gt;</i><b>WEB</b></span><h3>Construimos una experiencia sólida.</h3><p>Rápida, responsive y preparada para crecer.</p><span class="card-link-label">Explorar desarrollo <span aria-hidden="true">↗</span></span></a>
          <a class="discipline-card discipline-mint" href="/seo/"><span class="discipline-art" aria-hidden="true"><i>⌕</i><b>HALLA</b></span><h3>Conectamos lo que haces con lo que buscan.</h3><p>Contenido y técnica trabajando juntos.</p><span class="card-link-label">Ver planes SEO <span aria-hidden="true">↗</span></span></a>
          <a class="discipline-card discipline-lilac" href="/seo-ia/"><span class="discipline-art" aria-hidden="true"><i>∞</i><b>GEO</b></span><h3>Preparamos la información para nuevas búsquedas.</h3><p>Claridad útil para personas y asistentes.</p><span class="card-link-label">Explorar GEO + AEO <span aria-hidden="true">↗</span></span></a>
        </div>
      </section>

      <section class="services-section section-pad" id="servicios" aria-labelledby="services-title">
        <div class="section-heading centered-heading">
          <h2 id="services-title">DISEÑO WEB.<br /><span>SEO. PRESENCIA.</span></h2>
          <p class="section-intro">Cada servicio se conecta con un objetivo de negocio. Elige un punto de partida o conversemos para definir el correcto.</p>
          <a class="text-link" href="/servicios/">Explorar todos los servicios <span aria-hidden="true">↗</span></a>
        </div>
        <div class="services-grid">
          {SERVICES.map((service) => <ServiceCard {...service} href={service.slug} />)}
        </div>
      </section>

      <section class="local-directory-section section-pad" aria-labelledby="local-directory-title">
        <div class="section-heading heading-split">
          <div><h2 id="local-directory-title">Proyectos para empresas de la Región Metropolitana.</h2></div>
          <p class="section-intro">Explora las comunas donde RDS atiende proyectos. Cada página describe un contexto distinto y la modalidad real de trabajo.</p>
        </div>
        <div class="nearby-area-grid">
          <a href="/diseno-web-santiago/"><span>HUB / SANTIAGO</span><strong>Diseño web en Santiago</strong><i aria-hidden="true">↗</i></a>
          <a href="/diseno-web-santiago/providencia/"><span>ZONA ORIENTE</span><strong>Providencia</strong><i aria-hidden="true">↗</i></a>
          <a href="/diseno-web-santiago/las-condes/"><span>ZONA ORIENTE</span><strong>Las Condes</strong><i aria-hidden="true">↗</i></a>
          <a href="/diseno-web-santiago/nunoa/"><span>SANTIAGO</span><strong>Ñuñoa</strong><i aria-hidden="true">↗</i></a>
          <a href="/diseno-web-santiago/maipu/"><span>ZONA PONIENTE</span><strong>Maipú</strong><i aria-hidden="true">↗</i></a>
          <a href="/diseno-web-santiago/puente-alto/"><span>ZONA SUR</span><strong>Puente Alto</strong><i aria-hidden="true">↗</i></a>
        </div>
      </section>

      <section class="business-paths section-pad" aria-labelledby="paths-title">
        <div class="section-heading"><h2 id="paths-title">¿Necesitas una web nueva o mejorar la que ya tienes?</h2></div>
        <div class="path-grid">
          <a class="path-card path-new" href="/diseno-web/"><span class="path-doodle" aria-hidden="true">✳</span><h3>Necesito un sitio web.</h3><p>Diseñamos y desarrollamos tu sitio con una base SEO inicial. Puedes sumar posicionamiento mensual después del lanzamiento.</p><span class="text-link">Ver paquetes web <span aria-hidden="true">↗</span></span></a>
          <a class="path-card path-existing" href="/auditoria-seo/"><span class="path-doodle" aria-hidden="true">⌕</span><h3>Ya tengo una web.</h3><p>Primero auditamos la plataforma y sus riesgos. Luego cotizamos las mejoras aprobadas y, si te sirve, el trabajo mensual.</p><span class="text-link">Conocer la auditoría <span aria-hidden="true">↗</span></span></a>
        </div>
      </section>

      <section class="method-section section-pad" aria-labelledby="method-title">
        <div class="method-intro"><h2 id="method-title">De la idea al sitio que puedes hacer crecer.</h2><p>Sabes qué estamos haciendo, por qué lo hacemos y qué viene después.</p><a class="button button-ink" href="/estudio/">Conoce el estudio <span aria-hidden="true">↗</span></a></div>
        <div class="method-steps">
          <a class="method-step" href="/contacto/"><span>01</span><div><h3>Conversamos</h3><p>Entendemos el negocio, sus objetivos, la audiencia y el estado del sitio.</p><span class="card-link-label">Hablemos de tu proyecto <span aria-hidden="true">↗</span></span></div><span class="step-mark" aria-hidden="true">↗</span></a>
          <a class="method-step" href="/contacto/"><span>02</span><div><h3>Definimos</h3><p>Acordamos estructura, alcance, entregables y medición antes de empezar.</p><span class="card-link-label">Definir una propuesta <span aria-hidden="true">↗</span></span></div><span class="step-mark" aria-hidden="true">↗</span></a>
          <a class="method-step" href="/servicios/"><span>03</span><div><h3>Diseñamos o auditamos</h3><p>Construimos una web nueva o diagnosticamos la existente antes de intervenirla.</p><span class="card-link-label">Explorar servicios <span aria-hidden="true">↗</span></span></div><span class="step-mark" aria-hidden="true">↗</span></a>
          <a class="method-step" href="/seo/"><span>04</span><div><h3>Publicamos y evolucionamos</h3><p>Probamos los cambios aprobados y, si lo contratas, continuamos con posicionamiento mensual.</p><span class="card-link-label">Ver posicionamiento mensual <span aria-hidden="true">↗</span></span></div><span class="step-mark" aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="home-faq-section section-pad" aria-labelledby="home-faq-title">
        <div class="section-heading centered-heading">
          <h2 id="home-faq-title">Preguntas frecuentes</h2>
          <p class="section-intro">Precio, plazos, SEO, cobertura y propiedad del sitio: lo que conviene aclarar antes de contratar un proyecto.</p>
        </div>
        <div class="home-faq-list">
          <FaqAccordion items={FEATURED_FAQS} />
        </div>
        <a class="button button-ink section-end-button" href="/preguntas-frecuentes/">Ver todas las preguntas <span aria-hidden="true">↗</span></a>
      </section>

      <section class="home-plans section-pad" id="precios" aria-labelledby="web-plans-title">
        <div class="section-heading heading-split"><div><h2 id="web-plans-title">Elige el tamaño de tu nueva web.</h2></div><a class="text-link" href="/precios/">Ver todos los precios <span aria-hidden="true">↗</span></a></div>
        <div class="home-price-grid">{WEB_PLANS.map((plan, index) => <PriceCard plan={plan} tone={index === 1 ? 'orange' : index === 2 ? 'mint' : 'lilac'} compact={true} />)}</div>
        <div class="section-heading monthly-heading"><div><h2>Haz crecer la visibilidad de tu sitio.</h2><p class="section-intro">Los planes mensuales son independientes del desarrollo y comienzan después de revisar y preparar el sitio.</p></div></div>
        <div class="home-price-grid">{MONTHLY_PLANS.map((plan, index) => <PriceCard plan={plan} tone={index === 1 ? 'orange' : index === 2 ? 'mint' : 'lilac'} compact={true} />)}</div>
        <div class="audit-strip"><div><h3>{AUDIT.name}: {formatCLP(AUDIT.amount)}</h3><p>Diagnóstico independiente antes de definir las correcciones. La implementación se cotiza por separado.</p></div><a class="button button-ink" href="/auditoria-seo/">Ver qué incluye <span aria-hidden="true">↗</span></a></div>
      </section>

      <section class="project-teaser section-pad" aria-labelledby="project-teaser-title"><a class="project-teaser-art" href="/proyectos/" aria-label="Conocer cómo RDS presenta sus proyectos"><span>RDS /</span><i>✳</i><b>REAL<br />WORK<br />ONLY</b><span class="card-link-label">Ver proyectos <span aria-hidden="true">↗</span></span></a><div><h2 id="project-teaser-title">El trabajo se muestra con contexto y permiso.</h2><p>Publicamos casos con autorización, capturas reales y resultados que se pueden comprobar. Sin clientes inventados ni métricas de adorno.</p><a class="text-link" href="/proyectos/">Cómo contamos cada proyecto <span aria-hidden="true">↗</span></a></div></section>

      <section class="blog-section section-pad" aria-labelledby="blog-title">
        <div class="section-heading heading-split">
          <div><h2 id="blog-title">Ideas para construir una mejor presencia digital.</h2></div>
          <a class="text-link" href="/blog/">Ir al blog <span aria-hidden="true">↗</span></a>
        </div>
        <div class="blog-grid">
          {posts.map((post, index) => <BlogCard slug={post.id} title={post.data.title} description={post.data.description} category={post.data.category} publishDate={post.data.publishDate} readingTime={post.data.readingTime} tone={index === 1 ? 'lilac' : index === 2 ? 'yellow' : 'mint'} />)}
        </div>
      </section>

      <section class="price-teaser section-pad" aria-labelledby="price-title">
        <div class="price-orbit" aria-hidden="true"><span>✳</span><i></i></div>
        <div><h2 id="price-title">Una página por zona.<br /><span>Con algo útil que decir.</span></h2><p>Los paquetes de páginas locales se calculan por cantidad y se crean solo para zonas donde el negocio realmente presta servicios.</p></div>
        <a class="button button-ink" href="/seo-local/">Ver paquetes locales <span aria-hidden="true">↗</span></a>
      </section>

      <section class="contact-band section-pad" aria-labelledby="contact-title"><h2 id="contact-title">Hagamos que tu web<br />trabaje mejor.</h2><a class="button button-paper" href="/contacto/">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a><span class="contact-spark" aria-hidden="true">✳</span>
      </section>
    </main>
    <SiteFooter />
  </div>
  <style>
    .hero-split-section {
      padding-top: clamp(1.5rem, 3vw, 3rem);
      padding-bottom: 1.5rem;
      background: var(--beige);
      color: var(--ink);
    }

    .hero-split-layout {
      display: grid;
      max-width: 1480px;
      min-height: clamp(650px, 76vh, 860px);
      margin: 0 auto;
      grid-template-columns: minmax(0, 1.18fr) minmax(360px, .82fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 6rem);
    }

    .hero-split-copy {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      padding-block: clamp(3rem, 6vw, 6rem);
    }

    .hero-split-meta {
      display: flex;
      width: 100%;
      justify-content: space-between;
      gap: 1.5rem;
      margin-bottom: clamp(3rem, 7vw, 6.5rem);
      font-size: .55rem;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .hero-split-kicker {
      margin-bottom: 1rem;
      color: var(--violet);
      font-size: .66rem;
      font-weight: 900;
      letter-spacing: .11em;
    }

    .hero-split-copy h1 {
      max-width: 920px;
      margin-bottom: 1.25rem;
      font-size: clamp(4.2rem, 7.9vw, 8.9rem);
      line-height: .84;
      letter-spacing: -.075em;
      text-wrap: balance;
    }

    .hero-split-copy h1 span {
      color: var(--red);
    }

    .hero-split-subline {
      display: flex;
      flex-wrap: wrap;
      gap: .65rem;
      margin-bottom: 1.1rem;
      font-size: clamp(.56rem, .75vw, .72rem);
      font-weight: 900;
      letter-spacing: .08em;
    }

    .hero-split-subline i {
      color: var(--red);
      font-style: normal;
    }

    .hero-split-description {
      max-width: 680px;
      margin-bottom: 1.7rem;
      color: #504b46;
      font-size: clamp(1rem, 1.4vw, 1.2rem);
      line-height: 1.55;
    }

    .hero-split-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .hero-split-visual {
      position: relative;
      display: grid;
      min-height: 600px;
      place-items: center;
      isolation: isolate;
    }

    .hero-split-visual::before {
      content: "";
      position: absolute;
      z-index: -2;
      width: min(92%, 520px);
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--mint);
      transform: rotate(-7deg);
    }

    .hero-split-visual::after {
      content: "";
      position: absolute;
      z-index: -1;
      width: 38%;
      aspect-ratio: 1;
      right: 2%;
      bottom: 8%;
      border-radius: 50%;
      background: var(--red);
      opacity: .88;
    }

    .hero-image-frame {
      position: relative;
      z-index: 1;
      width: min(88%, 455px);
      padding: .55rem;
      background: var(--paper);
      box-shadow: 12px 12px 0 rgb(39 36 33 / 14%);
      transform: rotate(1.5deg);
    }

    .hero-image-frame img {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
    }

    .hero-split-number {
      position: absolute;
      z-index: 3;
      top: 2.2rem;
      right: 7%;
      font-size: .58rem;
      font-weight: 900;
      letter-spacing: .1em;
    }

    .hero-split-spark {
      position: absolute;
      z-index: 3;
      top: 3.4rem;
      left: 2%;
      color: var(--red);
      font-size: clamp(3rem, 6vw, 6rem);
      line-height: 1;
      transform: rotate(-14deg);
    }

    .hero-visual-caption {
      position: absolute;
      z-index: 4;
      right: 0;
      bottom: 4rem;
      display: flex;
      max-width: 280px;
      padding: .8rem .95rem;
      flex-direction: column;
      gap: .25rem;
      background: var(--ink);
      color: white;
      transform: rotate(-2deg);
    }

    .hero-visual-caption span {
      color: var(--lime);
      font-size: .53rem;
      font-weight: 900;
      letter-spacing: .09em;
    }

    .hero-visual-caption strong {
      font-size: 1rem;
    }

    .hero-split-note {
      display: grid;
      max-width: 1480px;
      margin: 0 auto;
      padding-top: 1.2rem;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      border-top: 1px solid rgb(39 36 33 / 22%);
      color: #625c55;
      font-size: .55rem;
      font-weight: 800;
      letter-spacing: .08em;
      text-align: center;
    }

    @media (max-width: 980px) {
      .hero-split-layout {
        grid-template-columns: 1fr;
      }

      .hero-split-copy {
        padding-bottom: 1rem;
      }

      .hero-split-meta {
        margin-bottom: 2.5rem;
      }

      .hero-split-visual {
        min-height: 500px;
      }
    }

    @media (max-width: 600px) {
      .hero-split-layout {
        min-height: 0;
      }

      .hero-split-copy {
        padding-block: 2.5rem 1rem;
      }

      .hero-split-meta {
        margin-bottom: 2.8rem;
        font-size: .46rem;
      }

      .hero-split-copy h1 {
        font-size: clamp(3.15rem, 14.6vw, 4.6rem);
      }

      .hero-split-description {
        font-size: .96rem;
      }

      .hero-split-actions {
        align-items: flex-start;
        flex-direction: column;
        gap: 1rem;
      }

      .hero-split-actions .button {
        width: 100%;
      }

      .hero-split-visual {
        min-height: 400px;
      }

      .hero-image-frame {
        width: min(84%, 320px);
      }

      .hero-visual-caption {
        right: 0;
        bottom: 1rem;
      }

      .hero-split-note {
        grid-template-columns: repeat(2, 1fr);
        text-align: left;
      }
    }

    .manifesto-intro {
      display: grid;
      max-width: 1360px;
      margin: 0 auto 12px;
      padding-block: clamp(1rem, 3vw, 3rem);
      grid-template-columns: minmax(360px, .9fr) minmax(0, 1.1fr);
      align-items: center;
      gap: clamp(2rem, 7vw, 7rem);
    }

    .manifesto-copy h2 {
      max-width: 780px;
      margin-bottom: 1.4rem;
      font-size: clamp(2.6rem, 5.7vw, 6.1rem);
      line-height: .88;
    }

    .manifesto-copy .section-intro {
      max-width: 660px;
      margin-bottom: 1.1rem;
    }

    .manifesto-signature {
      max-width: 570px;
      margin-bottom: 1.35rem;
      padding-left: 1rem;
      border-left: 4px solid var(--red);
      font-size: .95rem;
      font-weight: 700;
      line-height: 1.5;
    }

    @media (max-width: 1000px) {
      .manifesto-intro {
        max-width: 760px;
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
    }

    @media (max-width: 600px) {
      .manifesto-intro {
        grid-template-columns: minmax(0, 1fr);
      }

      .manifesto-copy h2 {
        font-size: clamp(2.45rem, 11vw, 3.8rem);
      }
    }
  </style>
</MainLayout>
