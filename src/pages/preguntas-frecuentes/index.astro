---
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { FAQ_CATEGORIES, FAQ_ITEMS } from '../../data/faqs';

const title = 'Preguntas Frecuentes sobre Diseño Web y SEO | RDS';
const description = 'Resolvemos dudas sobre diseño web, rediseño, precios, SEO local, plazos, soporte y propiedad del sitio. Revisa las respuestas antes de contratar.';
const schema = {
  '@type': 'FAQPage',
  name: 'Preguntas frecuentes sobre diseño web y SEO',
  description,
  inLanguage: 'es-CL',
  mainEntity: FAQ_ITEMS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---
<MainLayout title={title} description={description} schema={schema}>
  <div id="top" class="site-shell">
    <Header />
    <main id="contenido">
      <section class="directory-hero faq-page-hero section-pad">
        <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Preguntas frecuentes</span></nav>
        <p class="eyebrow"><span class="status-dot"></span> ANTES DE CONTRATAR / RESPUESTAS CLARAS</p>
        <h1>Preguntas frecuentes sobre <span>diseño web y SEO.</span></h1>
        <p class="directory-intro">Qué incluye un proyecto, cómo se calcula el precio, cuándo conviene rediseñar, qué ocurre con el SEO y cómo se trabaja en Santiago. Respuestas concretas antes de pedir una propuesta.</p>
        <nav class="faq-jump-links" aria-label="Categorías de preguntas">
          {FAQ_CATEGORIES.map((category) => <a href={`#${category.id}`}>{category.label}</a>)}
        </nav>
      </section>

      <section class="faq-page-content section-pad">
        <div class="faq-intro-note">
          <strong>¿No encuentras tu pregunta?</strong>
          <p>Puedes escribir directamente y revisamos el caso sin obligarte a elegir un servicio antes de conversar.</p>
          <a class="text-link" href="/contacto/">Haz tu pregunta <span aria-hidden="true">↗</span></a>
        </div>

        {FAQ_CATEGORIES.map((category) => {
          const items = FAQ_ITEMS.filter((item) => item.category === category.id);
          return (
            <section class="faq-group" id={category.id} aria-labelledby={`faq-${category.id}-title`}>
              <div class="faq-group-heading">
                <p class="eyebrow eyebrow-dark">{category.label.toUpperCase()}</p>
                <h2 id={`faq-${category.id}-title`}>{category.label}</h2>
                <span>{items.length.toString().padStart(2, '0')} PREGUNTAS</span>
              </div>
              <FaqAccordion items={items} />
            </section>
          );
        })}
      </section>

      <section class="faq-help section-pad">
        <div>
          <p class="eyebrow eyebrow-dark">SIGUIENTE PASO</p>
          <h2>Tu proyecto no tiene que empezar con todas las respuestas.</h2>
          <p>Cuéntanos qué hace tu negocio, qué necesita cambiar y qué plazo tienes. Si todavía no sabes qué servicio elegir, lo definimos en la primera conversación.</p>
        </div>
        <a class="button button-ink" href="/contacto/">Conversemos <span aria-hidden="true">↗</span></a>
      </section>
    </main>
    <SiteFooter />
  </div>
</MainLayout>
