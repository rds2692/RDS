---
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CharacterPortrait from '../../components/CharacterPortrait.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { SERVICES } from '../../site';
const websiteServices = SERVICES.filter((service) => service.slug === '/diseno-web/');
const growthServices = SERVICES.filter((service) => service.slug !== '/diseno-web/');
const title = 'Servicios de diseño web, SEO y SEO con IA';
const description = 'Diseño web, SEO local, auditoría y contenido para buscadores con IA. Revisa cómo trabaja RDS y elige la solución para tu empresa.';
---
<MainLayout title={`${title} | RDS`} description={description} schema={{ '@type': 'CollectionPage', name: title, description, inLanguage: 'es-CL' }}>
  <div id="top" class="site-shell"><Header /><main id="contenido">
    <section class="directory-hero section-pad"><nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><span aria-current="page">Servicios</span></nav><h1>Construimos tu web.<br /><span>O hacemos crecer la que ya tienes.</span></h1><p class="directory-intro">RDS acompaña empresas de servicios, profesionales y pymes principalmente de Chile y Latinoamérica. El punto de partida depende del estado actual de tu negocio.</p></section>
    <section class="service-line section-pad"><div class="service-line-heading"><h2>Necesitas un sitio nuevo.</h2><p>Desarrollamos la web con una base SEO inicial. Después puedes sumar posicionamiento mensual si lo necesitas.</p><a class="text-link" href="/diseno-web/">Ver planes web <span aria-hidden="true">↗</span></a></div><div class="services-grid">{websiteServices.map((service) => <ServiceCard {...service} href={service.slug} />)}</div></section>
    <section class="local-directory-section section-pad"><div class="section-heading heading-split"><div><h2>Una estructura para cada tipo de empresa.</h2></div><p class="section-intro">Explora la página para empresas, el hub de la Región Metropolitana y las zonas donde RDS presta servicio.</p></div><div class="nearby-area-grid"><a href="/diseno-web-empresas/"><span>WEB CORPORATIVA</span><strong>Diseño para empresas</strong><i aria-hidden="true">↗</i></a><a href="/diseno-web-santiago/"><span>REGIÓN METROPOLITANA</span><strong>Diseño web en Santiago</strong><i aria-hidden="true">↗</i></a><a href="/rediseno-web/"><span>SITIO EXISTENTE</span><strong>Rediseño web</strong><i aria-hidden="true">↗</i></a></div></section>
    <section class="services-section section-pad" aria-labelledby="growth-title"><div class="section-heading heading-split"><div><h2 id="growth-title">Ya tienes una web. Vamos a entenderla primero.</h2></div><p class="section-intro">Auditamos y definimos el trabajo antes de intervenir. La auditoría y la implementación inicial se cotizan por separado de la mensualidad.</p></div><div class="services-grid">{growthServices.map((service) => <ServiceCard {...service} href={service.slug} />)}</div></section>
    <section class="service-chooser service-character-choice section-pad"><div class="service-choice-copy"><h2>Cuéntame qué quieres resolver.</h2><p>No necesitas elegir una solución antes de conversar. Revisamos el objetivo y definimos el mejor punto de partida.</p><a class="button button-ink" href="/contacto/">Orientemos tu proyecto <span aria-hidden="true">↗</span></a></div><CharacterPortrait compact src="/images/armando/expresion-04.webp" alt="Armando Rangel escuchando atentamente" caption="Antes de proponer una solución, entendemos el punto de partida." tone="peach" /></section>
  </main><SiteFooter /></div>
  <style>
    .service-character-choice {
      display: grid;
      max-width: 1180px;
      margin-inline: auto;
      padding-block: clamp(4rem, 8vw, 8rem);
      grid-template-columns: minmax(0, 1fr) minmax(300px, .72fr);
      align-items: center;
      gap: clamp(2rem, 7vw, 7rem);
      text-align: left;
    }

    .service-choice-copy h2,
    .service-choice-copy p,
    .service-choice-copy .eyebrow {
      margin-inline: 0;
      text-align: left;
    }

    .service-choice-copy .eyebrow {
      justify-content: flex-start;
    }

    @media (max-width: 760px) {
      .service-character-choice {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
    }
  </style>
</MainLayout>
