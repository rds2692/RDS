# Origen canónico usado por Astro, canonicales, Schema, sitemap y robots.
SITE_URL=https://rangel.design

# Datos comerciales públicos. Usa URLs completas y separa perfiles con comas.
PUBLIC_BUSINESS_EMAIL=hola@rangel.design
PUBLIC_BUSINESS_PHONE=
PUBLIC_WHATSAPP_URL=
PUBLIC_SOCIAL_PROFILES=

# Token público del método "etiqueta HTML" de Search Console.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ID público de Google Analytics 4. La analítica no se carga si queda vacío.
PUBLIC_GA_MEASUREMENT_ID=

# Ruta opcional de Chrome para regenerar las tarjetas sociales.
CHROME_BIN=google-chrome
